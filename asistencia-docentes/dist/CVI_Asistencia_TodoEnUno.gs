    "        if (b0 == -1) break;",
    "        var b1 = read();",
    "        var b2 = read();",
    "        var b3 = read();",
    "        var k = String.fromCharCode( (b0 << 8) | b1);",
    "        var v = (b2 << 8) | b3;",
    "        unicodeMap[k] = v;",
    "        count += 1;",
